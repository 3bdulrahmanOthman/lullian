{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:mcp-surface:v1",
  "title": "Lullian MCP Security Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "targetRef",
    "protocolRevision",
    "transport",
    "serverIdentity",
    "authorizationModel",
    "maturity",
    "verificationBasis",
    "declaredAnnotationsHash",
    "verificationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "targetRef": {
      "type": "string",
      "minLength": 1
    },
    "protocolRevision": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "enum": [
        "STDIO",
        "SSE",
        "STREAMABLE_HTTP",
        "OTHER"
      ]
    },
    "serverIdentity": {
      "type": "string",
      "minLength": 1
    },
    "authorizationModel": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "inputSchemaHash": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "declaredReadOnly": {
            "type": "boolean"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "networkDestinations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "filesystemAccess": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "credentialAccess": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "subprocessCapability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "declaredAnnotationsHash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "inspectedCapabilityHash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "verificationStatus": {
      "enum": [
        "UNVERIFIED",
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "maturity": {
      "enum": [
        "DECLARED",
        "INSPECTED",
        "VERIFIED"
      ]
    },
    "verificationBasis": {
      "enum": [
        "STATIC",
        "CRYPTOGRAPHIC",
        "EXTERNAL_RUNTIME"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "maturity": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "maturity"
        ]
      },
      "then": {
        "required": [
          "inspectedCapabilityHash",
          "evidenceRefs"
        ],
        "properties": {
          "verificationStatus": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verificationStatus": {
            "const": "PASS"
          }
        },
        "required": [
          "verificationStatus"
        ]
      },
      "then": {
        "required": [
          "evidenceRefs"
        ]
      }
    }
  ]
}
