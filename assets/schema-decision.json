{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:decision:v1",
  "title": "Lullian Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "chosen",
    "status",
    "evidenceRefs",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "CONDITIONAL",
        "LOCKED",
        "DEFERRED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvalRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "LOCKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approver",
          "approvalRef",
          "lockedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUPERSEDED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "supersedes"
        ]
      }
    }
  ],
  "$comment": "Offline-safe schema identifier; local validation must not fetch network resources."
}
