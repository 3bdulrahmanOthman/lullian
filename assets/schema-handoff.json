{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:handoff:v2",
  "title": "Lullian Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "nextStep",
    "readinessEvidenceRefs"
  ],
  "properties": {
    "status": {
      "enum": [
        "READY",
        "READY_WITH_SPIKES",
        "NEEDS_CLARIFICATION",
        "NOT_READY"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "nextStep": {
      "type": "string",
      "minLength": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spikes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workflowRef": {
      "type": "string",
      "minLength": 1
    },
    "designState": {
      "type": "string",
      "minLength": 1
    },
    "requiredSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredMcps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "securityBlockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readinessEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admissionPlanRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "governanceBlockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verificationRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshnessEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "spikes": {
            "maxItems": 0
          },
          "securityBlockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY_WITH_SPIKES"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "spikes"
        ],
        "properties": {
          "spikes": {
            "minItems": 1
          },
          "blockers": {
            "maxItems": 0
          },
          "securityBlockers": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$comment": "Offline-safe schema identifier; local validation must not fetch network resources."
}
