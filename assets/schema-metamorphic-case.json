{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:metamorphic-case:v2",
  "title": "Lullian Metamorphic Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "input_change",
    "expected_local_changes",
    "must_not_change"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "input_change": {
      "type": "string",
      "minLength": 1
    },
    "expected_local_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_not_change": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "category": {
      "enum": [
        "CORE",
        "GOVERNANCE"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
