{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:documentation-manifest:v1",
  "title": "Lullian Documentation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "status",
          "sourceRefs",
          "owner"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "CANONICAL",
              "SUMMARY",
              "GENERATED"
            ]
          },
          "status": {
            "enum": [
              "REQUIRED",
              "OPTIONAL",
              "STALE",
              "MISSING"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "freshness": {
            "enum": [
              "LIVE",
              "CURRENT",
              "RECENT",
              "EVERGREEN"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Offline-safe schema identifier; local validation must not fetch network resources."
}
