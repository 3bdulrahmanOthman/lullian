{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:quality-attribute:v1",
  "title": "Lullian Quality Attribute",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "target",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "MUST",
        "SHOULD",
        "COULD"
      ]
    },
    "measure": {
      "type": "string",
      "minLength": 1
    },
    "threshold": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "architectureImplications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testImplications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$comment": "Offline-safe schema identifier; local validation must not fetch network resources."
}
