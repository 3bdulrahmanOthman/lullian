{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lullian:schema:source-precedence:v1",
  "title": "Lullian Source Precedence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "sourceClass"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "sourceClass": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "exception": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Offline-safe schema identifier; local validation must not fetch network resources."
}
